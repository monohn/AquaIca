# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aquaica

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=AquaIca API
DEBUG=true
API_V1_PREFIX=/api/v1

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
